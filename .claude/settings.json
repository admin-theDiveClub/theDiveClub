{
	"permissions": {
		"deny": [
			"Bash(git commit)", "Bash(git commit *)",
			"Bash(git push)", "Bash(git push *)",
			"Bash(npx supabase db push *)", "Bash(npx supabase config push *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/eol/hook.mjs\"" }]
			}
		]
	}
}